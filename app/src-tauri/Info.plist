<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Merged into the macOS app's Info.plist by Tauri; these keys replace the ones Tauri generates
     from bundle > fileAssociations, because Tauri has no setting for a document icon.
     Keep them in step with fileAssociations in tauri.conf.json. ferry-file.icns is copied into
     Contents/Resources by bundle > macOS > files. -->
<plist version="1.0">
<dict>
  <key>CFBundleDocumentTypes</key>
  <array>
    <dict>
      <key>CFBundleTypeName</key>
      <string>Ferry share</string>
      <key>CFBundleTypeRole</key>
      <string>Viewer</string>
      <key>CFBundleTypeIconFile</key>
      <string>ferry-file.icns</string>
      <key>LSHandlerRank</key>
      <string>Owner</string>
      <key>LSItemContentTypes</key>
      <array>
        <string>dev.ferry.share</string>
      </array>
    </dict>
  </array>
  <key>UTExportedTypeDeclarations</key>
  <array>
    <dict>
      <key>UTTypeIdentifier</key>
      <string>dev.ferry.share</string>
      <key>UTTypeDescription</key>
      <string>Ferry share file</string>
      <key>UTTypeConformsTo</key>
      <array>
        <string>public.data</string>
      </array>
      <key>UTTypeIconFile</key>
      <string>ferry-file.icns</string>
      <key>UTTypeTagSpecification</key>
      <dict>
        <key>public.filename-extension</key>
        <array>
          <string>ferry</string>
        </array>
        <key>public.mime-type</key>
        <array>
          <string>application/x-ferry</string>
        </array>
      </dict>
    </dict>
  </array>
</dict>
</plist>
