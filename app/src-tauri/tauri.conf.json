{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ferry",
  "version": "0.1.0",
  "identifier": "dev.ferry.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Ferry",
        "width": 1040,
        "height": 720,
        "minWidth": 760,
        "minHeight": 540,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "freezePrototype": true,
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "ferry"
        ],
        "name": "Ferry share",
        "description": "Ferry share file",
        "role": "Viewer",
        "mimeType": "application/x-ferry"
      }
    ],
    "shortDescription": "Share files directly with anyone, anywhere",
    "longDescription": "Ferry sends files and folders straight from your computer to another person's, peer-to-peer and end-to-end encrypted, with no upload to a cloud service.",
    "resources": {
      "../../LICENSE": "LICENSE",
      "../../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "../node_modules/@fontsource-variable/recursive/LICENSE": "LICENSE-Recursive.txt"
    },
    "macOS": {
      "signingIdentity": "-",
      "files": {
        "Resources/ferry-file.icns": "icons/ferry-file.icns"
      }
    },
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installerHooks": "windows/hooks.nsh"
      },
      "wix": {
        "fragmentPaths": [
          "windows/ferry-file-icon.wxs"
        ],
        "componentRefs": [
          "FerryFileIcon"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": ["https://github.com/Alexxfromgit/Ferry/releases/latest/download/latest.json"],
      "requireSignedVersion": true
    },
    "deep-link": {
      "desktop": {
        "schemes": [
          "ferry"
        ]
      }
    }
  }
}
